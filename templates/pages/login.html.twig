{% block javascript_block %}
    <script type="text/javascript">
        $(function () {
            $('#login_name').focus();

            // Toggle password visibility
            $('#togglePasswordBtn').on('click', function() {
                var pwdInput = $('#login_password');
                var icon = $('#togglePasswordIcon');
                if (pwdInput.attr('type') === 'password') {
                    pwdInput.attr('type', 'text');
                    icon.removeClass('ti-eye').addClass('ti-eye-off');
                } else {
                    pwdInput.attr('type', 'password');
                    icon.removeClass('ti-eye-off').addClass('ti-eye');
                }
            });

            {% if show_lost_password and config('display_login_source') %}
                if ($('select[name="auth"]').val() === 'local') {
                    $('.forgot_password').removeClass('d-none');
                }
                $('select[name="auth"]').on('change', function () {
                    if ($(this).val() === 'local') {
                        $('.forgot_password').removeClass('d-none');
                    } else {
                        $('.forgot_password').addClass('d-none');
                    }
                });
            {% endif %}
        });
    </script>
{% endblock %}
